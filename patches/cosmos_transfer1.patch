+# PATCH: additional embedding utilities needed by the custom training stack
+
+class Timesteps(nn.Module):
+    """Sinusoidal timestep embedding (non-SDXL variant)."""
+    def __init__(self, num_channels):
+        super().__init__()
+        self.num_channels = num_channels
+
+    def forward(self, timesteps):
+        in_dtype = timesteps.dtype
+        half_dim = self.num_channels // 2
+        exponent = -math.log(10000) * torch.arange(half_dim, dtype=torch.float32,
+                                                    device=timesteps.device)
+        exponent = exponent / (half_dim - 0.0)
+        emb = torch.exp(exponent)
+        emb = timesteps[:, None].float() * emb[None, :]
+        emb = torch.cat([torch.cos(emb), torch.sin(emb)], dim=-1)
+        return emb.to(in_dtype)
+
+
+class TimestepEmbedding(nn.Module):
+    """MLP timestep embedding (non-SDXL variant)."""
+    def __init__(self, in_features: int, out_features: int, use_adaln_lora: bool = False):
+        super().__init__()
+        self.linear_1 = nn.Linear(in_features, out_features, bias=not use_adaln_lora)
+        self.activation = nn.SiLU()
+        self.use_adaln_lora = use_adaln_lora
+        if use_adaln_lora:
+            self.linear_2 = nn.Linear(out_features, 3 * out_features, bias=False)
+        else:
+            self.linear_2 = nn.Linear(out_features, out_features, bias=True)
+
+    def forward(self, sample: torch.Tensor):
+        emb = self.linear_2(self.activation(self.linear_1(sample)))
+        if self.use_adaln_lora:
+            return sample, emb          # emb_B_D, adaln_lora_B_3D
+        return emb, None
+
+
+class FourierFeatures(nn.Module):
+    """Random Fourier feature layer. [B] -> [B, D]"""
+    def __init__(self, num_channels, bandwidth=1, normalize=False):
+        super().__init__()
+        self.register_buffer("freqs",
+            2 * np.pi * bandwidth * torch.randn(num_channels), persistent=True)
+        self.register_buffer("phases",
+            2 * np.pi * torch.rand(num_channels), persistent=True)
+        self.gain = np.sqrt(2) if normalize else 1.0
+
+    def forward(self, x, gain: float = 1.0):
+        in_dtype = x.dtype
+        x = (x.to(torch.float32).ger(self.freqs.to(torch.float32))
+               .add(self.phases.to(torch.float32)))
+        return x.cos().mul(self.gain * gain).to(in_dtype)
+
